############################
#   Classes
############################

# Class: obo:GEO_000000004 (subnational entity)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000004 "a governmental organization that has a local, regional, or territorial government that recognizes a sovereign state as its higher political authority"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000004 "Amanda Hicks"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000004 "William R. Hogan"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000004 "subnational entity"@en)
SubClassOf(obo:GEO_000000004 obo:GEO_000000400)

# Class: obo:GEO_000000005 (major administrative subdivision)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000005 "A subnational entity that is the primary organizational member of a nation, is subject to the full set of laws of the nation, enjoys all the privileges established under the laws of the nation, is not a member of any other geopolitical entity, and itself governs a part of the geographical region governed by the nation."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000005 "Amanda Hicks"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000005 "William R. Hogan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000005 "examples: Northern Ireland, Florida"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000005 "major administrative subdivision"@en)
SubClassOf(obo:GEO_000000005 obo:GEO_000000004)

# Class: obo:GEO_000000006 (geopolitical dependency)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000006 "A subnational entity that does not possess full political independence or sovereignty as a sovereign state, but remains politically outside of the controlling state and controls a geographical region that is outside the controlling state's integral region."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000006 "Amanda Hicks"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000006 "William R. Hogan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000006 "Typically, the common feature is that the dependency does not conduct foreign affairs, and relegates this authority to the sovereign state.  But otherwise, it is largely or completely autonomous relative to the administrative subdivisions.  Examples include Puerto Rico (U.S.), Guam (U.S.), Greenland (Denmark), French Polynesia (France), and Falkland Islands (United Kingdom). "@en)
AnnotationAssertion(rdfs:label obo:GEO_000000006 "geopolitical dependency"@en)
SubClassOf(obo:GEO_000000006 obo:GEO_000000004)

# Class: obo:GEO_000000370 (geographical entity)

AnnotationAssertion(obo:IAO_0000111 obo:GEO_000000370 "geographical entity of astronomical body"@en)
AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000370 "A material entity that is (1) a bona fide or fiat object part of the crust, any bodies of liquid on or contained within the crust, or planetary boundary layer (if present) of a terrestrial planet (including Earth), dwarf planet, exoplanet, natural satellite, planetesimal, or small Solar System body, and that (2) overlaps the planetary surface (including having a boundary that coincides with part of the planetary surface)."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000370 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000370 "Matt Diller"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000370 "William R. Hogan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000370 "Includes atmosphere, crust, geographical regions (e.g., the geographical region over which the state of Florida has jurisdiction), bodies of water, mountains, etc.

Generally, an individual organism is a distinct object that is not a part of the Earth, although this requires more thought.  But the intent is definitely for this class to NOT subsume organism universally.  Human beings are contained within, but not part of, the Earth, for example."@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000370 "Note that despite the word 'planetary' in 'planetary surface', it refers generally to surface of dwarf planets, asteroids, moons, etc."@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000370 "We note that not all planets have a surface per se (e.g., gas giants such as Jupiter and Saturn).  So only planets, natural satellites, etc. with a planetary surface (with or without a planetary boundary layer) have geographical entities."@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000370 "We note that the term 'geography' is also applied to the Earth's moon, Mars, Venus, and possibly even other moons and planets in our own solar system and beyond.  

Thus, we are attempting to define things generally enough that they could be reused for the geographical entities/features on the Moon, Mars, other planets, exoplanets, other natural satellites (a.k.a moons), asteroids, etc."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000370 "geographical entity"@en)
SubClassOf(obo:GEO_000000370 obo:BFO_0000040)

# Class: obo:GEO_000000371 (geographical feature)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000371 "A geographical entity that has at least one bona fide boundary."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000371 "geographical feature"@en)
SubClassOf(obo:GEO_000000371 obo:GEO_000000370)

# Class: obo:GEO_000000372 (geographical region)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000372 "A geographical entity that is demarcated at least in part by one or more closed fiat boundaries all of whose lines are part of the planetary surface."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000372 "François Modave"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000372 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000372 "Matt Diller"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000372 "William R. Hogan"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000372 "geographical region"@en)
SubClassOf(obo:GEO_000000372 obo:GEO_000000370)

# Class: obo:GEO_000000391 (geopoli organization)

AnnotationAssertion(obo:IAO_0000111 obo:GEO_000000391 "geopolitical organization"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000391 "Amanda Hicks"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000391 "geopoli organization"@en)
SubClassOf(obo:GEO_000000391 obo:OBI_0000245)

# Class: obo:GEO_000000392 (private governance organization)

AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000392 "Amanda Hicks"@en)
AnnotationAssertion(obo:IAO_0000119 obo:GEO_000000392 "\"Although the very meaning of the term is controversial, it involves authoritative decsionmaking in areas that once were part of national legal frameworks, the government, the sovereign state, or the public sector.\"

Karns and Mingst (2004) p. 14.")
AnnotationAssertion(dc:contributor obo:GEO_000000392 "Katrina Donovan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000392 "Examples: private bond-rating agencies such as Moody's Investors Service, International Chamber of Commerce, Worldwide Responsible Apparel Manufacturing Principles, Forest Stewardship"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000392 "private governance organization"@en)
SubClassOf(obo:GEO_000000392 obo:GEO_000000391)

# Class: obo:GEO_000000393 (nongovernmental organization)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000393 "a geopolitical organization that is voluntary and private, whose members are individual persons or organizations that come together to acheive a common purpose."@en)
AnnotationAssertion(obo:IAO_0000119 obo:GEO_000000393 "NGOs are private voluntary organizations whose members are individuals or associations that come together to acheive a common purpose.  Some organizations are formed to advocate a particular cause such as human rights, peace, or envirnomental projetion.  Others are established to provide services such as disaster relief, humantarian aid in war-torn socieities, or development assistance.  ... National level groups are often called interest or pressure groups, and many of them are now linked to counterpart groups in other countries through transnational networks or federations.  International NGOs, like IGOs, may draw their members from one region or several regions, and they may have very specific functions or be multi-functional.

Karns and Mingst (2004) p. 10f."@en)
AnnotationAssertion(dc:contributor obo:GEO_000000393 "Katrina Donovan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000393 "Examples:
Internaltion Federation of Red Cross and Red Crescent Societies, Oxfam, CARE, Doctors Without Borders, World Wildlife Fund, Transparency International, Human Rights Watch, Amnesty International, and Save the Children."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000393 "nongovernmental organization"@en)
SubClassOf(obo:GEO_000000393 obo:GEO_000000391)

# Class: obo:GEO_000000395 (intergovernmental organization)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000395 "an intergovernmental organization that has at least three member states, that has activies in at least three states, and that is unified by some formal intergovernmental agreement")
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000395 "Amanda Hicks"@en)
AnnotationAssertion(obo:IAO_0000119 obo:GEO_000000395 "\"IGOs are organizations whose memebers include at lesat three states, that have activities in several states, and whose members are held together by a formal intergovernmental agreement ... These organizations range in size from three members (North American Free Trade Argreement [NAFTA]) to more than 190 memembers (Universal Postal Union (UPU)].  Memebers may come from primarily one georgraphic regioni (Oragnaization of American States [OAS]) or from all geographic regions (World Bank).  although soem IGOs are designed to achieve a single purpose (Organization of Petroleum exporting countries [OPEC]), others have been developed for multiple tasks (United Nations [UN}).  ... IGOs are recognized subjects of international law with separate standing fromt heir member states.\" Karns and Mingst I(2004) p. 7")
AnnotationAssertion(dc:contributor obo:GEO_000000395 "Katrina Donovan"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000395 "examples:
North American Free Trade Argreement [NAFTA] , Universal Postal Union [UPU], Oragnaization of American States [OAS], World Bank), Organization of Petroleum exporting countries [OPEC] United Nations [UN[, The World Trade Organization [WTO], The World Health Organization [WHO], UNICEF"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000395 "intergovernmental organization"@en)
SubClassOf(obo:GEO_000000395 obo:GEO_000000391)

# Class: obo:GEO_000000396 (sovereign state)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000396 "A governmental organization with a defined territory on which it exercises internal and external sovereignty, a permanent population, a government, and the capacity to enter into relations with other sovereign states."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000396 "William R. Hogan"@en)
AnnotationAssertion(obo:IAO_0000118 obo:GEO_000000396 "de facto sovereign state"@en)
AnnotationAssertion(obo:IAO_0000118 obo:GEO_000000396 "de facto state"@en)
AnnotationAssertion(obo:IAO_0000118 obo:GEO_000000396 "nation"@en)
AnnotationAssertion(obo:IAO_0000118 obo:GEO_000000396 "nation state"@en)
AnnotationAssertion(obo:IAO_0000119 obo:GEO_000000396 "http://en.wikipedia.org/wiki/Sovereign_state"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000396 "Per Wikipedia, the word 'nation' does not always refer to soverign states.  For example, the \"nation of Islam\"."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000396 "sovereign state"@en)
SubClassOf(obo:GEO_000000396 obo:GEO_000000400)

# Class: obo:GEO_000000400 (governmental organization)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000400 "An organization that governs the people living in a particular geographical region or aggregate of geographical regions.  The geographical region it governs can change over time (such as the westward expansion of the United States and the addition of Hawaii). 

Note: this definition was taken over from \"geopolitical organization\"."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000400 "Amanda Hicks"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000400 "IMPORTANT: The label \"geopolitical organization\" was previously used for OMRSE_00000044 (governmental organization).  \"geopoli organization\" is a label for a new and different class."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000400 "governmental organization"@en)
SubClassOf(obo:GEO_000000400 obo:OBI_0000245)

# Class: obo:GEO_000000788 (geodetic datum)

AnnotationAssertion(obo:IAO_0000111 obo:GEO_000000788 "geodetic datum"@en)
AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000788 "A coordinate system, and a set of reference points, used to locate places on the Earth (or similar objects)."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000788 "Josh Hanna"@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000788 "William R. Hogan"@en)
AnnotationAssertion(obo:IAO_0000119 obo:GEO_000000788 "Wikipedia: https://en.wikipedia.org/wiki/Geodetic_datum

Date accessed: 2015-04-13"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000788 "Every latitude and longitude measurement is with respect to a geodetic datum.  Most common ones in use are NAD83 and WGS84."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000788 "geodetic datum"@en)
SubClassOf(obo:GEO_000000788 obo:IAO_0000030)

# Class: obo:GEO_000000797 (de jure sovereign state)

AnnotationAssertion(obo:IAO_0000115 obo:GEO_000000797 "A sovereign state whose political sovereignty has been recognized by the United Nations, in accordance with international law."@en)
AnnotationAssertion(obo:IAO_0000117 obo:GEO_000000797 "Matthew Diller")
AnnotationAssertion(obo:IAO_0000118 obo:GEO_000000797 "de jure state"@en)
AnnotationAssertion(rdfs:comment obo:GEO_000000797 "Sovereignty, in the legal sense, is acquired by a state upon receiving recognition by the international community. However, without specifying that this recognition can only be acquired through full membership to the United Nations, a non-arbitrary standard would be difficult, if not impossible, to come by since there are a good many sovereign states whose sovereignty is not explicitly recognized by one or more states. Given that the de facto criteria for sovereignty must be achieved prior to membership to the UN General Assembly and that every member therein is considered to be \"international recognized,\" full membership to the UN is a sufficient criterion for de jure sovereignty. This can be further justified by noting that, in cases where UN member X claims to not recognize the sovereign status of UN member Y, the diplomatic and political behavior of member X towards Y nevertheless tacitly implies that it recognizes Y's sovereignty."@en)
AnnotationAssertion(rdfs:label obo:GEO_000000797 "de jure sovereign state"@en)
SubClassOf(obo:GEO_000000797 obo:GEO_000000396)


