AnnotationAssertion(obo:IAO_0000111 obo:GEO_000000790 "angular degree"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000790 "angular degree"@en)
AnnotationAssertion(rdfs:label obo:GEO_000000790 "°"@en)


