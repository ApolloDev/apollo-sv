AnnotationAssertion(obo:IAO_0000117 obo:OBI_0000658 "Melanie Courtot")
AnnotationAssertion(obo:IAO_0000118 obo:OBI_0000658 "data structure")
AnnotationAssertion(obo:IAO_0000118 obo:OBI_0000658 "data structure specification")
AnnotationAssertion(obo:IAO_0000119 obo:OBI_0000658 "GROUP: OBI")
AnnotationAssertion(obo:IAO_0000232 obo:OBI_0000658 "2009-02-28: work on this term has been finalized during the OBI workshop winter 2009")
AnnotationAssertion(rdfs:label obo:OBI_0000658 "data representational model")
SubClassOf(obo:OBI_0000658 obo:IAO_0000033)

