# Class: obo:OBI_0000679 (average value)

AnnotationAssertion(obo:IAO_0000111 obo:OBI_0000679 "average value")
AnnotationAssertion(obo:IAO_0000114 obo:OBI_0000679 obo:IAO_0000125)
